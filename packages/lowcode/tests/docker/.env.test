# 低代码平台测试环境变量配置
# 复制此文件为 .env 并修改相应配置

# ==================== 数据库配置 ====================
TEST_DB_USER=test
TEST_DB_PASSWORD=test123
TEST_DB_NAME=lowcode_test
TEST_DB_PORT=5433

# ==================== Redis 配置 ====================
TEST_REDIS_PASSWORD=test123
TEST_REDIS_PORT=6380

# ==================== MinIO 配置 ====================
TEST_MINIO_USER=test
TEST_MINIO_PASSWORD=test123
TEST_MINIO_PORT=9000
TEST_MINIO_CONSOLE_PORT=9001

# ==================== Mock AI Server ====================
TEST_MOCK_AI_PORT=8888
TEST_MOCK_AI_MODE=normal  # normal, error, timeout, random
TEST_MOCK_AI_DELAY=1000  # 模拟延迟 (ms)

# ==================== 低代码平台 ====================
TEST_APP_PORT=8081
TEST_BASE_URL=http://localhost:8081

# ==================== Playwright 测试配置 ====================
PW_TEST_BASE_URL=http://localhost:8081
PW_TEST_TIMEOUT=60000
PW_TEST_HEADED=false
PW_TEST_SLOWMO=0

# ==================== 测试报告配置 ====================
TEST_REPORT_DIR=./reports
TEST_VIDEO_DIR=./videos
TEST_SCREENSHOT_DIR=./screenshots
