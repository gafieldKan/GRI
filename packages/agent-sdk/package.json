{
  "name": "@gri/agent-sdk",
  "version": "0.1.0",
  "description": "GRI 业务 agent 薄 HTTP 客户端 —— 对 /api/v1/agent/* 版本化契约的零运行时依赖调用面（外部项目接入入口）",
  "type": "module",
  "main": "src/index.js",
  "types": "index.d.ts",
