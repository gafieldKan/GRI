      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\""
  },
  "keywords": [
    "gri",
    "agent",
    "sdk",
    "http",
    "client"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "publishConfig": {
    "registry": "https://registry.npmmirror.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://example.invalid/gri.git",
    "directory": "packages/agent-sdk"
  },
  "homepage": "https://example.invalid/gri/packages/agent-sdk"
