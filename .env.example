# GRI 生产运行环境变量 —— 一键部署入口
#
# 用法：
#   cp .env.example .env.prod     # 编辑真实值
#   npm run build:all-h5          # 前端构建产物
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#       --env-file .env.prod up -d --build
#
# 安全铁律：本文件是模板，不含任何真实密钥。真实 `.env` / `.env.prod` 一律 gitignore、不入库。
# 运算符 secrets（LLM key / 支付验签 / 服务间令牌 / JWT 私钥）只经 env 在部署期注入，永不持久化到 DB 或前端。

# ── PostgreSQL（两台后端库共用同一密码，prod overlay 强制必填）──
POSTGRES_PASSWORD=                 # 必填。postgres(-auth) 容器 password + api/auth-center DB_PASSWORD

# ── 大模型（M5 AI 垂直；缺省空 → nvapi- gate 走 mock/dev）──
LLM_API_KEY=                       # NVIDIA 真实 key（nvapi-...），operator secret
LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731
LLM_PROVIDER=nvidia
LLM_MULTIMODAL_MODEL=nvidia/neva-22b

# ── 支付回执验签 secret（不入库）──
PAYMENT_NOTIFY_SECRET=             # 必填。支付 notify 回调验签，与颁发方约定一致

# ── 服务间令牌（auth-center SERVICE_TOKEN / api AUTH_SERVICE_TOKEN 须一致）──
# 授权 api 在 assertSiteOperator 后代查身份目录(PII) 的共享令牌；两服务必须同步同值。
AUTH_SERVICE_TOKEN=                # 必填。强随机值，勿用默认

# ── JWT 签名密钥对（RS256）：config.ts 优先 env 值；注入多行 PEM 用单引号包裹/换行转义──
#   生产注入稳定密钥对，保证跨重启/多副本已签发 token 持续有效。
#   缺省走容器内 ensure-keys 卷持久化（dev 路径），生产建议显式注入。
JWT_PRIVATE_KEY=                   # 可选（生产建议）。RSA-2048 私钥 PEM（pkcs8）
JWT_PUBLIC_KEY=                    # 可选（生产建议）。对应公钥 PEM（spki）

# ── 前端构建（可选）：默认同源相对（''），部署到独立 CDN/域名时设绝对 origin 覆盖 ──
# VITE_API_BASE_URL=
# VITE_AUTH_BASE_URL=               # apps/web 用