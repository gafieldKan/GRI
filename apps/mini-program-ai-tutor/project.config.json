{
  "description": "智学慧眼 - AI 智能学情分析与互动辅导系统（微信小程序）",
  "packOptions": {
    "ignore": [
      { "value": "node_modules", "type": "folder" },
      { "value": "tests", "type": "folder" },
      { "value": "vitest.config.js", "type": "file" },
      { "value": ".gitignore", "type": "file" }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "preloadBackgroundData": false,
    "minified": true,
    "newFeature": false,
    "coverView": true,
    "nodeModules": false,
    "autoAudits": false,
    "showShadowRootInWxmlPanel": true,
    "scopeDataCheck": false,
    "uglifyFileName": false,
    "checkInvalidKey": true,
    "checkSiteMap": true,
    "uploadWithSourceMap": true,
    "compileHotReLoad": false,
    "lazyCodeLoading": "requiredComponents",
    "useMultiFrameRuntime": true,
    "useApiHook": true,
    "useApiHostProcess": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "condition": false
  },
  "compileType": "miniprogram",
  "libVersion": "3.0.0",
  "appid": "",
  "projectname": "smart-lens-ai-tutor-mp",
  "condition": {},
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}