# GRI Auth Center 环境变量模板（复制为 .env 填写，.env 不入库）

# 服务
PORT=3004

# 数据库（身份域 gri_auth）
DB_HOST=localhost
DB_PORT=5434
DB_NAME=gri_auth
DB_USER=postgres
DB_PASSWORD=postgres

# JWT（RS256 非对称）
# 生产：注入 RSA PEM（多行），或指定文件路径（JWT_PRIVATE_KEY_FILE / JWT_PUBLIC_KEY_FILE）
# 开发：留空则自动生成临时 RSA-2048（重启后失效，仅供本地）
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=gri-auth-center
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000