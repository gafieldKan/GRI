# ===========================================
# 智学慧眼 AI Tutor Backend — 环境变量配置示例
# ===========================================
# 复制此文件为 .env 并填入真实值即可
# .env 已被 .gitignore 排除，不会提交到仓库

# -------------------------------------------
# 服务端口
# -------------------------------------------
PORT=3003

# -------------------------------------------
# 数据库配置
# -------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartlens
DB_USER=postgres
DB_PASSWORD=your_db_password

# -------------------------------------------
# Redis 配置 (可选)
# -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -------------------------------------------
# 大模型 API 配置
# -------------------------------------------
# NVIDIA API: https://build.nvidia.com/explore/discover
# 获取 API Key: https://build.nvidia.com/
# OpenAI 兼容格式: 可使用其他兼容 OpenAI 的 LLM 服务
# 推荐: deepseek-ai/deepseek-v4-pro-0813 (已验证稳定可用)
# 备选: nvidia/nemotron-3-super-120b-a12b (需确认 account 权限)
LLM_API_KEY=your_api_key_here
LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_MODEL=deepseek-ai/deepseek-v4-pro-0813
LLM_PROVIDER=nvidia

# -------------------------------------------
# WebSocket 配置
# -------------------------------------------
WS_HEARTBEAT_INTERVAL=30000

# -------------------------------------------
# JWT 校验（auth-center 签发，业务后端用公钥校验）
# -------------------------------------------
# 鉴权中心地址（JWKS 动态拉取公钥）
AUTH_JWKS_URL=http://localhost:3004/auth/jwks
# 生产推荐：直接注入公钥 PEM（绕过 JWKS 拉取，最健壮）
# AUTH_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
# AUTH_PUBLIC_KEY_FILE=/run/secrets/auth_public_key.pem
# 期望的 JWT 签发者（须与 auth-center JWT_ISSUER 一致）
JWT_ISSUER=gri-auth-center
