{
  "name": "gri-api",
  "version": "0.1.0",
  "description": "GRI 唯一业务后端（NestJS + TypeScript）—— 订餐 + AI 学情 + 组织/主数据 + 本体门面",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\"",
    "migrate": "node dist/migrate/run-migrations.js",
    "etl:converge": "node dist/migrate/etl-converge.js",
    "etl:converge-ai": "node dist/migrate/etl-converge-ai.js"
  },
  "dependencies": {
    "@gri/jwt-verifier": "file:../../packages/jwt-verifier",
    "@gri/ontology": "file:../../packages/ontology",
    "@gri/ontology-engine": "file:../../packages/ontology-engine",
    "@gri/agent-core": "file:../../packages/agent-core",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^1.10.3",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}