# Dependencies
node_modules/
.pnpm/

# Build output
dist/
build/
*.log

# Environment files
.env
.env.local
.env.*.local
.env.*
!.env.example
*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Temporary files
tmp/
temp/

# Package lock files (optional, uncomment if needed)
# package-lock.json
# pnpm-lock.yaml
# yarn.lock

# Private keys
*.key
*.pem
*.crt

# Backend specific
*.sqlite
*.db
data/
services/backend/data/

# Ops/dump artifacts (DB backups may contain PII)
ops/

# Mini-program specific
project.private.config.json

# Documentation markdown files in wrong places (but preserve docs/ and app docs)
*.md
!README.md
!CONTRIBUTING.md
!CHANGELOG.md
!docs/**/*.md
!**/docs/**/*.md
!**/README.md
# 插件技能正文是**承载内容**（content payload），不是散落的文档 —— 它被装载器读入 prompt，
# 漏提交等于插件声明了 skill 却读不出（PLUGIN_SKILL_MISSING）→ 教师静默失去全部教学指令。
!**/SKILL.md

# Backup files
*.backup
*.backup*
*.bak
*.before_*
*.orig

# Scratch / generated output
*.out
uploads/

# 生产 TLS 证书（自签/LE，运行时生成，勿入库）
ssl/

# k12-curriculum 版图审核前草稿（真源为 maps/*.map.json，草稿仅推导过程）
scripts/k12-curriculum/maps-draft/

# .agents/ 协作工作区 —— 任务卡 / 设计文档 / 交接记录 / 验收脚本纳入版本历史
# （因全局 *.md 被忽略，这里显式反向豁免其下的 .md/.sh/.json）
!.agents/**/*.md
!.agents/**/*.sh
!.agents/**/*.json

# reference-data 骨架数据（联合国区域划分 / ISIC 行业分类）。抽取产物 checked-in，
# 保证 import.mjs 可脱离外部源文件重现；真源抽取见 scripts/reference-data/extract.mjs
!scripts/reference-data/data/
!scripts/reference-data/data/**

# 运行时噪音（大日志、完成标记、临时构建日志）不入库
.agents/coordination/logs/
.agents/coordination/*.log
.agents/**/.done

# 一次性 scratch 目录
.p2t4/

# Explorer 参考浏览器（从源 HTML 复制，体积大，勿入库；来源见 apps/explorer/README.md）
apps/explorer/region.html
apps/explorer/industry.html
# 区域细分几何（52MB，派生自源文件）
scripts/reference-data/data/un-regions-maps.geo.json
