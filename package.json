{
  "name": "gri-monorepo",
  "version": "1.0.0",
  "description": "GRI Monorepo — 多行业平台 (订餐 + AI 辅导 + 本体引擎)",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=services/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:web-ai": "npm run dev:h5 --workspace=apps/web-ai-tutor",
    "dev:mini-ai": "npm run dev:weixin --workspace=apps/mini-program-ai-tutor",
    "dev": "npm run dev:api",
    "build:web": "npm run build:h5 --workspace=apps/web",
    "build:web-ai": "npm run build:h5 --workspace=apps/web-ai-tutor",
    "build:portal": "npm run build:h5 --workspace=apps/portal",
    "build:all-h5": "npm run build:web && npm run build:web-ai && npm run build:portal",
    "build": "npm run build --workspaces --if-present",
    "test:web-ai": "npm run test:run --workspace=apps/web-ai-tutor --if-present",
    "test:mini-ai": "npm run test:run --workspace=apps/mini-program-ai-tutor --if-present",
    "test:ontology": "npm run test --workspace=packages/ontology",
    "test:ontology-engine": "npm run test --workspace=packages/ontology-engine",
    "test:codegen": "npm run test --workspace=packages/codegen",
    "test:all": "npm run test:web-ai && npm run test:mini-ai && npm run test:ontology && npm run test:ontology-engine && npm run test:codegen",
    "test": "npm run test --workspace=services/api",
    "test:e2e": "node scripts/full-test.js",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "rm -rf apps/*/dist services/*/dist packages/*/dist apps/*/node_modules services/*/node_modules packages/*/node_modules node_modules"
  },
  "dependencies": {
    "@dcloudio/uni-cli-shared": "^3.0.0-alpha-5010320260611001"
  },
  "overrides": {
    "vue": "3.5.41",
    "@vue/shared": "3.5.41",
    "@vue/reactivity": "3.5.41",
    "@vue/runtime-core": "3.5.41",
    "@vue/runtime-dom": "3.5.41",
    "@vue/compiler-core": "3.5.41",
    "@vue/compiler-dom": "3.5.41",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/server-renderer": "3.5.41"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^5.0.0"
  },
  "keywords": [
    "gri",
    "restaurant",
    "ordering-system",
    "ai-tutor",
    "ontology",
    "monorepo"
  ],
  "author": "GRI Team",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/gafieldKan/GRI.git"
  }
}
